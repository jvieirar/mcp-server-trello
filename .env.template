# Trello API Configuration
# Get your API key from https://trello.com/app-key
TRELLO_API_KEY=your-api-key-here

# Generate your token using your API key
TRELLO_TOKEN=your-token-here

# Optional: Initial workspace ID (can be changed later using set_active_workspace)
# TRELLO_WORKSPACE_ID=your-workspace-id-here

# Webhook setup for Trello events
WEBHOOK_ENABLED=true                       # set to 'false' to disable the webhook listener
WEBHOOK_URL=https://<tailscale-url>/webhook
WEBHOOK_PORT=8899                          # port the MCP webhook server listens on

TRELLO_MEMBER_ID=<your-id>   # optional — skip the /members/me call

# Agent configuration (when webhook is enabled)
AGENT_RUNNER=claude                        # claude | copilot
AGENT_MODEL=claude-sonnet-4-6             # model passed to the runner (default: claude-sonnet-4-6 for claude, claude-haiku-4.5 for copilot)
AGENT_MAX_TURNS=20                         # max turns before the agent stops (claude only)